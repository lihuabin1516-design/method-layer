{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccpanes.local/method-layer/v0.1/handoff.schema.json",
  "title": "CC-Panes Method Handoff v0.1",
  "description": "Structured nine-section controller handoff contract.",
  "type": "object",
  "required": [
    "protocolVersion",
    "artifactType",
    "handoffId",
    "createdAt",
    "role",
    "taskId",
    "currentResult",
    "requiredReading",
    "baseline",
    "facts",
    "evidence",
    "objective",
    "authorization",
    "forbidden",
    "conditionalAuthorization",
    "executionOrder",
    "agentDispatchBoundary",
    "requiredChecks",
    "acceptanceAssertions",
    "audit",
    "fuse",
    "stopConditions",
    "artifacts",
    "delivery",
    "nextOrder"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "artifactType": {
      "const": "handoff"
    },
    "handoffId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^handoff-[A-Za-z0-9][A-Za-z0-9._:-]{1,119}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "$ref": "#/$defs/taskId"
    },
    "currentResult": {
      "type": "string",
      "minLength": 1
    },
    "requiredReading": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "facts": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "evidence": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "authorization": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "forbidden": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "conditionalAuthorization": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "executionOrder": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "agentDispatchBoundary": {
      "type": "object",
      "required": [
        "allowed",
        "requiredReporting"
      ],
      "properties": {
        "allowed": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "requiredReporting": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "additionalProperties": false
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "acceptanceAssertions": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "audit": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "fuse": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "stopConditions": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "artifacts": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "delivery": {
      "type": "object",
      "required": [
        "format",
        "requirements"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "additionalProperties": false
    },
    "nextOrder": {
      "$ref": "#/$defs/nonEmptyStrings"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "taskId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "head": {
      "description": "Literal 'unborn' when no commit exists, otherwise a 40-character commit SHA.",
      "type": "string",
      "pattern": "^(unborn|[0-9a-fA-F]{40})$"
    },
    "gitBaseline": {
      "type": "object",
      "required": [
        "branch",
        "head",
        "status"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "$ref": "#/$defs/head"
        },
        "status": {
          "type": "object",
          "required": [
            "state",
            "summary"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "clean",
                "dirty",
                "untracked",
                "mixed"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": [
        "projectPath",
        "repoRoot",
        "git",
        "relevantRules"
      ],
      "properties": {
        "workspaceName": {
          "type": "string",
          "minLength": 1
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "repoRoot": {
          "type": "string",
          "minLength": 1
        },
        "git": {
          "$ref": "#/$defs/gitBaseline"
        },
        "relevantRules": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "additionalProperties": false
    }
  }
}
