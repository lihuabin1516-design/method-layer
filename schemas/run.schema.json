{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccpanes.local/method-layer/v0.1/run.schema.json",
  "title": "CC-Panes Method Run v0.1",
  "description": "Execution binding between a task contract and a concrete runner session.",
  "type": "object",
  "required": [
    "protocolVersion",
    "artifactType",
    "runId",
    "taskRef",
    "startedAt",
    "status",
    "runner",
    "workspace",
    "contract"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "artifactType": {
      "const": "run"
    },
    "runId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._:-]{1,123}$"
    },
    "taskRef": {
      "type": "object",
      "required": [
        "taskId",
        "protocolVersion"
      ],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/taskId"
        },
        "protocolVersion": {
          "const": "0.1"
        },
        "artifactPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "running",
        "blocked",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "runner": {
      "type": "object",
      "required": [
        "cliTool",
        "profile",
        "session"
      ],
      "properties": {
        "cliTool": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "runtimeKind": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "object",
          "required": [
            "sessionId"
          ],
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1
            },
            "resumeSessionId": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": [
        "projectPath",
        "worktreePath",
        "branch"
      ],
      "properties": {
        "workspaceName": {
          "type": "string",
          "minLength": 1
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "worktreePath": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "description": "Immutable launch-time snapshot of the task fields that govern the run.",
      "type": "object",
      "required": [
        "capturedAt",
        "objective",
        "allowedPaths",
        "forbiddenActions",
        "acceptance",
        "requiredEvidence",
        "stopConditions"
      ],
      "properties": {
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "allowedPaths": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "forbiddenActions": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "conditionalActions": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "acceptance": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "requiredEvidence": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "stopConditions": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "taskId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
