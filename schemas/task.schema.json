{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccpanes.local/method-layer/v0.1/task.schema.json",
  "title": "CC-Panes Method Task v0.1",
  "description": "Authoritative task intent, authorization, baseline, acceptance, and evidence contract.",
  "type": "object",
  "required": [
    "protocolVersion",
    "artifactType",
    "taskId",
    "createdAt",
    "objective",
    "riskMode",
    "authorization",
    "baseline",
    "acceptance",
    "requiredEvidence",
    "stopConditions",
    "lineage",
    "status"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "artifactType": {
      "const": "task"
    },
    "taskId": {
      "$ref": "#/$defs/taskId"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "riskMode": {
      "description": "Advisory-only workflow depth in v0.1; adapters must not treat it as authorization.",
      "type": "string",
      "enum": [
        "simple",
        "standard",
        "deep"
      ]
    },
    "authorization": {
      "type": "object",
      "required": [
        "allowedPaths",
        "forbiddenActions"
      ],
      "properties": {
        "allowedPaths": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "forbiddenActions": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "conditionalActions": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "acceptance": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "requiredEvidence": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "stopConditions": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "lineage": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "specId": {
          "type": "string",
          "minLength": 1
        },
        "ticketId": {
          "type": "string",
          "minLength": 1
        },
        "reviewId": {
          "type": "string",
          "minLength": 1
        },
        "pr": {
          "type": "string",
          "minLength": 1
        },
        "parentTaskIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taskId"
          }
        },
        "externalRefs": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "blocked",
        "ready-for-review",
        "closed"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "taskId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "head": {
      "description": "Literal 'unborn' when no commit exists, otherwise a 40-character commit SHA.",
      "type": "string",
      "pattern": "^(unborn|[0-9a-fA-F]{40})$"
    },
    "gitBaseline": {
      "type": "object",
      "required": [
        "branch",
        "head",
        "status"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "$ref": "#/$defs/head"
        },
        "status": {
          "type": "object",
          "required": [
            "state",
            "summary"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "clean",
                "dirty",
                "untracked",
                "mixed"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": [
        "projectPath",
        "repoRoot",
        "git",
        "relevantRules"
      ],
      "properties": {
        "workspaceName": {
          "type": "string",
          "minLength": 1
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "repoRoot": {
          "type": "string",
          "minLength": 1
        },
        "git": {
          "$ref": "#/$defs/gitBaseline"
        },
        "relevantRules": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "additionalProperties": false
    }
  }
}
