          "技术方案/修改类需求prompt.md"
        ],
        "transformation": "idea-level-rewrite"
      },
      "knownLimitations": [
        "It requires actual schema and query evidence for concrete index advice.",
        "It does not authorize migrations or production data operations."
      ],
      "contentPath": "prompts/persistence-design.md"
    },
    {
      "id": "security-review",
      "version": "0.1.0",
      "title": "Authentication, Authorization, and Security Review",
      "purpose": "Evaluate security boundaries and denied paths from repository facts while keeping remediation within task authority.",
      "applicableStages": [
        "design",
        "build",
        "verify",
        "audit"
      ],
      "requiredInputs": [
        "task.objective",
        "task.authorization",
        "projectFacts.repository",
        "projectFacts.securityModel",
        "projectFacts.contracts"
      ],
      "optionalInputs": [
        "projectFacts.dataClassification",
        "projectFacts.threatModel",
        "projectFacts.auditRequirements"
      ],
      "outputContract": [
        "Scope",
        "Confirmed Security Facts",
        "Trust Boundaries",
        "Authentication and Authorization",
        "Data and Audit Controls",
        "Verification",
        "Risks",
        "Acceptance Assertions"
      ],
      "acceptanceAssertions": [
        "Authorization is checked before side effects and denied paths are testable.",
        "Secrets, credentials, and production data are neither requested nor emitted.",
        "Framework-specific security advice is tied to confirmed project versions and contracts."
      ],
      "sourceProvenance": {
        "repository": "https://github.com/jwangkun/ai-coding-prompt-java.git",
        "branch": "main",
        "commit": "1959b508696c7d92d550c152c735f49ed6dafbe2",
        "commitDate": "2025-11-25",
        "paths": [
