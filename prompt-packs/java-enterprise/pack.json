  "prompts": [
    {
      "id": "requirement-review",
      "version": "0.1.0",
      "title": "Requirement and Existing-Implementation Review",
      "purpose": "Compare the requested outcome with repository facts, existing contracts, tests, and authorization before design or implementation.",
      "applicableStages": [
        "shape",
        "design",
        "verify",
        "audit"
      ],
      "requiredInputs": [
        "task.objective",
        "task.authorization",
        "projectFacts.repository",
        "projectFacts.contracts",
        "projectFacts.tests"
      ],
      "optionalInputs": [
        "projectFacts.securityModel",
        "projectFacts.dataModel",
        "projectFacts.incidentHistory"
      ],
      "outputContract": [
        "Scope",
        "Confirmed Facts",
        "High-Confidence Inferences",
        "Open Assumptions",
        "Gap Analysis",
        "Verification",
        "Risks",
        "Acceptance Assertions"
      ],
      "acceptanceAssertions": [
        "Every finding is traceable to a requirement, contract, file, test, or explicit task constraint.",
        "Missing project facts remain explicit and block unsupported implementation claims.",
        "The review does not expand task authorization."
      ],
      "sourceProvenance": {
        "repository": "https://github.com/jwangkun/ai-coding-prompt-java.git",
        "branch": "main",
        "commit": "1959b508696c7d92d550c152c735f49ed6dafbe2",
        "commitDate": "2025-11-25",
        "paths": [
          "rules/Review需求实现检查prompt.md",
          "prompt整体介绍.md"
        ],
        "transformation": "idea-level-rewrite"
      },
      "knownLimitations": [
        "This Prompt identifies evidence gaps but does not decide product priority.",
        "It does not replace project-specific review policy or runtime evidence."
      ],
      "contentPath": "prompts/requirement-review.md"
    },
    {
      "id": "solution-design",
      "version": "0.1.0",
      "title": "Java Enterprise Solution Design",
      "purpose": "Produce a bounded design from confirmed project facts without defaulting to a fixed Spring implementation.",
      "applicableStages": [
        "design",
        "build"
      ],
      "requiredInputs": [
        "task.objective",
        "task.authorization",
        "projectFacts.repository",
        "projectFacts.contracts",
        "projectFacts.tests",
        "projectFacts.technologyProfile"
      ],
      "optionalInputs": [
        "projectFacts.dataModel",
        "projectFacts.securityModel",
        "projectFacts.runtimeTopology",
        "projectFacts.performanceEvidence"
      ],
      "outputContract": [
        "Scope",
        "Confirmed Facts",
        "Architecture",
        "Components and Contracts",
        "Impact",
        "Verification",
        "Risks",
        "Acceptance Assertions"
      ],
      "acceptanceAssertions": [
        "The design names owners, consumers, changed contracts, and dependency direction.",
        "Concrete framework versions and implementation types come only from the technology profile and repository facts.",
        "Database, authentication, and authorization concerns are delegated to their focused Prompt when triggered."
      ],
      "sourceProvenance": {
        "repository": "https://github.com/jwangkun/ai-coding-prompt-java.git",
        "branch": "main",
        "commit": "1959b508696c7d92d550c152c735f49ed6dafbe2",
        "commitDate": "2025-11-25",
        "paths": [
          "技术方案/新增类需求prompt.md",
          "技术方案/修改类需求prompt.md",
          "业务层/业务层prompt.md",
          "应用层/接口定义prompt.md"
        ],
        "transformation": "idea-level-rewrite"
      },
      "knownLimitations": [
        "It provides a design contract, not a complete implementation.",
        "It does not infer performance targets or deployment topology."
      ],
      "contentPath": "prompts/solution-design.md"
    },
    {
      "id": "persistence-design",
      "version": "0.1.0",
      "title": "Persistence and Data Model Design",
      "purpose": "Review data ownership, schema impact, migration, consistency, rollback, and query evidence for Java enterprise changes.",
      "applicableStages": [
        "design",
        "build",
        "verify"
      ],
      "requiredInputs": [
        "task.objective",
        "task.authorization",
        "projectFacts.repository",
        "projectFacts.dataModel",
        "projectFacts.technologyProfile"
      ],
      "optionalInputs": [
        "projectFacts.migrationPolicy",
        "projectFacts.queryEvidence",
        "projectFacts.retentionPolicy"
      ],
      "outputContract": [
        "Scope",
        "Confirmed Data Facts",
        "Ownership and Invariants",
        "Schema and Migration",
        "Consistency and Recovery",
        "Verification",
        "Risks",
        "Acceptance Assertions"
      ],
      "acceptanceAssertions": [
        "No table, field, index, migration tool, or database engine is invented without project evidence.",
        "Data changes include rollback or roll-forward and reconciliation.",
        "Authentication or authorization data changes remain subject to the security Prompt and task approval."
      ],
      "sourceProvenance": {
        "repository": "https://github.com/jwangkun/ai-coding-prompt-java.git",
        "branch": "main",
        "commit": "1959b508696c7d92d550c152c735f49ed6dafbe2",
