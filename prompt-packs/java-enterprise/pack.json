      "acceptanceAssertions": [
        "Every proposed test maps to a changed contract, risk, or acceptance assertion.",
        "Framework and test-library syntax follows the repository's existing test stack.",
        "Performance thresholds are proposed only when baseline and target evidence exist."
      ],
      "sourceProvenance": {
        "repository": "https://github.com/jwangkun/ai-coding-prompt-java.git",
        "branch": "main",
        "commit": "1959b508696c7d92d550c152c735f49ed6dafbe2",
        "commitDate": "2025-11-25",
        "paths": [
