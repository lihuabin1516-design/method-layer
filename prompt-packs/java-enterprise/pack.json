    {
      "id": "test-generation",
      "version": "0.1.0",
      "title": "Evidence-Oriented Test Design",
      "purpose": "Design focused tests and acceptance assertions that falsify the requested behavior and its important failure paths.",
      "applicableStages": [
        "build",
        "verify"
      ],
      "requiredInputs": [
        "task.objective",
        "task.authorization",
        "projectFacts.repository",
        "projectFacts.contracts",
        "projectFacts.tests",
        "projectFacts.technologyProfile"
      ],
      "optionalInputs": [
        "projectFacts.dataModel",
        "projectFacts.securityModel",
        "projectFacts.performanceEvidence"
      ],
      "outputContract": [
        "Scope",
        "Confirmed Test Facts",
        "Test Matrix",
        "Fixture and Data Strategy",
        "Execution Commands",
        "Expected Failures and Passes",
        "Risks",
        "Acceptance Assertions"
