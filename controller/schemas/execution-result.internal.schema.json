{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccpanes.local/method-layer/controller/v0.1/execution-result.internal.schema.json",
  "title": "CC-Panes Method Layer Controller Execution Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "executionId",
    "planId",
    "planSha256",
    "mode",
    "status",
    "startedAt",
    "completedAt",
    "journalPath",
    "leaderNotification",
    "steps",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1-internal" },
    "artifactType": { "const": "controller-execution-result" },
    "executionId": {
      "type": "string",
      "pattern": "^execution-[a-f0-9]{32}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^controller-plan-[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "mode": {
      "type": "string",
      "enum": ["dry-run", "live"]
    },
    "status": {
      "type": "string",
      "enum": ["dry-run", "completed", "manual-review", "failed"]
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "journalPath": {
      "type": ["string", "null"]
    },
    "leaderNotification": {
      "type": "string",
      "enum": [
        "not-applicable",
        "auto-notify-expected",
        "manual-report-planned"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence", "tool", "status", "attempts"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "tool": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["pending", "succeeded", "failed", "skipped"]
          },
          "attempts": { "type": "integer", "minimum": 0 },
          "responsePath": { "type": "string", "minLength": 1 },
          "responseSha256": {
            "type": "string",
            "pattern": "^[A-F0-9]{64}$"
          },
          "error": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
